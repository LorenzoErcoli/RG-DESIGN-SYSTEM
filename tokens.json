{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": { "name": "RG Design System", "version": "1.16.0", "status": "draft" },
  "brand": { "name": "RG", "organization": "ERREGI", "qualities": ["technical", "editorial", "textile", "precise", "sober"] },
  "typography": {
    "fontFamily": {
      "identity": "AGNext, Arial, sans-serif",
      "body": "GT-America-Standard, Helvetica, Arial, sans-serif",
      "mono": "GT-America-Mono, Consolas, monospace"
    },
    "fontSize": { "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px", "xl": "28px", "2xl": "36px", "display": "48px" },
    "lineHeight": { "tight": 1.1, "heading": 1.2, "body": 1.5, "technical": 1.4 },
    "fontWeight": { "regular": 400, "medium": 500, "bold": 700, "heading": "{typography.fontWeight.bold}" },
    "letterSpacing": { "tight": "-0.02em", "normal": "0", "label": "0.04em" }
  },
  "colors": {
    "permanent": { "black": "#000000", "white": "#FFFFFF" },
    "neutral": { "50": "#F7F7F5", "100": "#EFEFEC", "200": "#DEDEDA", "400": "#9A9A94", "600": "#62625D", "800": "#282826" },
    "seasonal": {
      "perugino": {
        "status": "placeholder-pending-source-sampling",
        "sage": "#89958A",
        "powderBlue": "#AABCC7",
        "lightGray": "#D7D7D1",
        "sandOchre": "#B79A62"
      }
    },
    "semantic": {
      "background": "{colors.neutral.50}",
      "surface": "{colors.neutral.100}",
      "surfaceRaised": "{colors.permanent.white}",
      "textPrimary": "{colors.permanent.black}",
      "textSecondary": "{colors.neutral.600}",
      "textLabel": "{colors.neutral.800}",
      "border": "{colors.neutral.200}",
      "borderMedium": "{colors.neutral.400}",
      "borderStrong": "{colors.permanent.black}",
      "actionPrimary": "{colors.permanent.black}",
      "actionPrimaryText": "{colors.permanent.white}",
      "actionSecondary": "{colors.permanent.white}",
      "focus": "{colors.permanent.black}",
      "success": "#365C45",
      "warning": "#7A5A16",
      "danger": "#8A2E2E",
      "info": "#36596B",
      "accentSage": "{colors.seasonal.perugino.sage}",
      "accentBlue": "{colors.seasonal.perugino.powderBlue}",
      "accentSand": "{colors.seasonal.perugino.sandOchre}"
    },
    "categorical": {
      "note": "Palette QUALITATIVA a 7 valori: distingue categorie pari-ordinate (reparti, serie di un grafico, layer) dove non esiste una gerarchia. Non e una scala di stato e non va usata per stato, azione o navigazione. Riusa i valori gia in palette (nessun colore nuovo nel brand): l'alias dichiara che qui il valore vale come CATEGORIA, non come significato. Regola d'uso: mai unico segnale — chi la usa deve affiancare nome e/o trama.",
      "1": "{colors.permanent.black}",
      "2": "{colors.semantic.info}",
      "3": "{colors.semantic.danger}",
      "4": "{colors.semantic.warning}",
      "5": "{colors.semantic.success}",
      "6": "{colors.seasonal.perugino.sandOchre}",
      "7": "{colors.seasonal.perugino.sage}"
    }
  },
  "spacing": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px" },
  "radius": { "none": "0", "sm": "2px", "md": "4px", "lg": "8px", "pill": "999px" },
  "borders": { "width": { "hairline": "1px", "strong": "2px" }, "style": "solid" },
  "shadows": { "none": "none", "overlay": "0 8px 24px rgba(0, 0, 0, 0.10)" },
  "layout": { "contentMax": "1440px", "readingMax": "720px", "sidebar": "280px", "toolPanel": "380px", "paramColMin": "132px", "header": "64px", "gridGap": "24px", "columns": { "mobile": 4, "tablet": 8, "desktop": 12 } },
  "zIndex": { "base": 0, "sticky": 100, "dropdown": 200, "overlay": 300, "modal": 400, "lightbox": 450, "toast": 500 },
  "motion": { "fast": "120ms", "normal": "200ms", "easing": "cubic-bezier(0.2, 0, 0, 1)" }
}

